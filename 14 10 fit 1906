<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bố cục Responsive</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
    }

    .container {
      display: grid;
      grid-template-areas:
        "header header"
        "content aside"
        "boxes boxes"
        "footer footer";
      grid-template-columns: 2fr 1fr;
      gap: 10px;
      padding: 10px;
    }

    header {
      grid-area: header;
      background-color: #9ad6c6;
      text-align: center;
      padding: 20px;
    }

    main {
      grid-area: content;
      background-color: #c9f2f2;
      text-align: center;
      padding: 20px;
    }

    aside {
      grid-area: aside;
      background-color: #f4c8b5;
      text-align: center;
      padding: 20px;
    }

    .boxes {
      grid-area: boxes;
      display: flex;
      gap: 10px;
      background-color: #f8f7d3;
      justify-content: space-around;
      flex-wrap: wrap;
      padding: 10px;
    }

    .box {
      background-color: #f0f0b3;
      flex: 1 1 100px;
      text-align: center;
      padding: 20px;
    }

    footer {
      grid-area: footer;
      background-color: #e7b7f8;
      text-align: center;
      padding: 20px;
    }

    /* Responsive cho tablet */
    @media (max-width: 900px) {
      .container {
        grid-template-areas:
          "content"
          "aside"
          "boxes"
          "footer";
        grid-template-columns: 1fr;
      }

      .boxes {
        justify-content: center;
      }

      .box {
        flex: 1 1 45%;
      }
    }

    /* Responsive cho điện thoại */
    @media (max-width: 600px) {
      .container {
        grid-template-areas:
          "header"
          "content"
          "aside"
          "boxes"
          "footer";
        grid-template-columns: 1fr;
      }

      .boxes {
        flex-direction: column;
        align-items: stretch;
      }

      .box {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header>HEADER</header>
    <main>CONTENT</main>
    <aside>ASIDE</aside>
    <div class="boxes">
      <div class="box">Box 1</div>
      <div class="box">Box 2</div>
      <div class="box">Box 3</div>
      <div class="box">Box 4</div>
    </div>
    <footer>FOOTER</footer>
  </div>
</body>
</html>
